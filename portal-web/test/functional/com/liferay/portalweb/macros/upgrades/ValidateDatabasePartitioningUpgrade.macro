	@summary = "Validates that Quartz indexes are created"
	macro validateQuartzIndexes() {
		var hasIndex = SQL.hasIndex(indexName = "IX_88328984");

		if (${hasIndex} == "false") {
			fail("Index IX_88328984 is missing");
		}

